!.env.example

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Local temp artifacts
tmp/

# Catalog pipeline intermediates: snapshots are regenerated by `catalog:pull`, and
# saved retailer pages are multi-megabyte browser dumps that can carry session state.
scripts/catalog/snapshots/*.json
scripts/catalog/manual/*
!scripts/catalog/manual/.gitkeep
