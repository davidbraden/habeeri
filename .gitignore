# dependencies
node_modules/

# Expo
.expo/
.expo-shared/
web-build/
dist/

# Native build outputs
*.apk
*.aab
*.ipa
android/
ios/

# Metro / bundler logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
metro-debug.log*

# TypeScript
*.tsbuildinfo

# Tests / coverage
coverage/

# Environment files
.env
